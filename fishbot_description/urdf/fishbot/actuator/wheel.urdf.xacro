<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro"/>

    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <!-- 机器人的IMU部件，惯性测量单元 -->
        <link name="${wheel_name}_link">
            <!-- 部件的外观描述 -->
            <visual>
                <!-- 描述1：坐标系原点：沿着自己几何中心的偏移和旋转 -->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>

                <!-- 描述2：几何形状 -->
                <geometry>
                    <!-- 圆柱 半径0.032m 宽度0.04m（外观） -->
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>

                <!-- 描述3：材质颜色 -->
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>

            <collision>
                <!-- 描述1：坐标系原点：沿着自己几何中心的偏移和旋转 -->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>

                <!-- 描述2：几何形状 -->
                <geometry>
                    <!-- 圆柱 半径0.032m 宽度0.01m（碰撞）
                         比外观窄：Gazebo(ODE) 把圆柱与地面的接触点算在圆柱边缘，
                         4cm 宽时有效轮距会在 0.16m/0.24m 之间跳，原地旋转里程计误差约 20%；
                         改为 1cm 后误差约 1~3%。半径必须与控制器 wheel_radius 一致 -->
                    <cylinder radius="0.032" length="0.01"/>
                </geometry>

                <!-- 描述3：材质颜色 -->
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </collision>

            <xacro:cylinder_inertia m="0.05" r="0.032" h="0.04" rpy="1.57079 0.0 0.0"/>

        </link>

        <!-- 机器人的关节 -->
        <joint name="${wheel_name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <axis xyz="0.0 1.0 0.0"/>
            <!-- <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/> -->
        </joint>

        <gazebo reference="${wheel_name}_link">
            <!-- 第一摩擦方向（切向）的摩擦系数，橡胶轮在地板上约 0.4~1.0 -->
            <mu1 value="0.7"/>
            <!-- 第二摩擦方向（切向，与第一方向垂直）的摩擦系数 -->
            <mu2 value="0.7"/>
            <!-- 接触刚度 N/m：1e6 时每个接触点下沉约 0.004mm -->
            <kp value="1000000.0"/>
            <!-- 接触阻尼 N*s/m：约 2*sqrt(kp*m)，m≈0.38kg（每个接触点分担的质量），阻尼比≈1，不弹跳 -->
            <kd value="1200.0"/>
        </gazebo>

    </xacro:macro>

</robot>
